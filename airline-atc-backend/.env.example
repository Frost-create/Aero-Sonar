# OpenSky API client credentials (recommended; create an API client in your OpenSky account)
OPENSKY_CLIENT_ID=your-client-id
OPENSKY_CLIENT_SECRET=your-client-secret

# API and WebSocket server
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Polling: authenticated default = 25s; anonymous default = 240s.
# Keep this conservative to avoid exhausting OpenSky API credits.
POLL_INTERVAL_MS=

# Regional surveillance bounding box (Bay Area default)
# OpenSky expects latitude/longitude bounds.
LAMIN=36.5
LAMAX=38.5
LOMIN=-123.5
LOMAX=-121.0

# Remove an aircraft from the active set after this many seconds without a state update.
# Increase this if you prefer stale tracks to remain visible longer.
TRACK_TTL_SECONDS=90

# Optional: set true to log concise polling summaries
LOG_POLL_SUMMARY=true
